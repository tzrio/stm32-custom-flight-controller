# PlatformIO build output and local IDE state
.pio/
.vscode/

# Python/local web-server artifacts
__pycache__/
*.py[cod]

# Local logs and captures
*.log
*.csv
*.webm
*.mp4
captures/

# Local configuration and editor backups
.env
.env.*
*.swp
*.swo
*~

# Firmware artifacts are regenerated by PlatformIO
*.elf
*.bin
*.hex

# Reference projects and recordings must not be versioned here.
# They currently live outside this repository root, but these rules also keep
# them excluded if copied into this directory later.
PX4-Autopilot/
qgroundcontrol/
QGroundControl/
videos/
